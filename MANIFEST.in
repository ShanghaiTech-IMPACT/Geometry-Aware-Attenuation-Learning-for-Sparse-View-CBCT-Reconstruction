include .gitignore .github/workflows/tests.yml
include README.md requirements.txt requirements-dev.txt gaal_cli.py
include train.py trainer.py evaluate.py DRR_simulation.py index.html
include train_lightning.py benchmark_memory.py
include DRR_simulation_leap.py
